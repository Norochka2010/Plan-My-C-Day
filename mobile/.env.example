# Copy to mobile/.env.local (gitignored) and fill in. Values are inlined at build time.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Logging to Grafana (docs/logging.md). Optional: without these the app runs but uploads no logs.
# Ask Jason for the two secrets. Debug builds use STAGING, release/TestFlight builds use PRODUCTION.
EXPO_PUBLIC_LOG_BRIDGE_URL=https://logs.starterschool.com/v1/logs
EXPO_PUBLIC_LOG_BRIDGE_SECRET_STAGING=
EXPO_PUBLIC_LOG_BRIDGE_SECRET_PRODUCTION=
