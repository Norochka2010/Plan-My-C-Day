        },
        {
          "id": "RLC_010_V2_D2_AFTER2",
          "type": "consequence",
          "text": "You keep ownership of the decision.",
          "next_node_id": "RLC_010_V2_D3"
        },
        {
          "id": "RLC_010_V2_D2_AFTER3",
          "type": "consequence",
          "text": "You make your decision without needing agreement.",
          "next_node_id": "RLC_010_V2_D3"
        },
        {
          "id": "RLC_010_V2_D2_AFTER4",
          "type": "consequence",
          "text": "You move on without debating.",
          "next_node_id": "RLC_010_V2_D3"
        },
        {
          "id": "RLC_010_V2_D2",
          "type": "decision",
          "text": "Someone says, “It should be fine.” How do you want to respond?",
