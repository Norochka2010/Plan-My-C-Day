    },
    "graph": {
      "format": "rlc_branching_v1",
      "start_node_id": "RLC_010_V2_OPEN",
      "nodes": [
        {
          "id": "RLC_010_V2_OPEN",
          "type": "opening",
          "text": "You have gathered information about a food situation. Some things are clear; some may still feel uncertain. The decision is yours.",
          "next_node_id": "RLC_010_V2_D1"
