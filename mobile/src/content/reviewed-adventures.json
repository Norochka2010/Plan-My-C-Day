          "type": "consequence",
          "text": "You choose to look at the available information again before deciding.",
          "next_node_id": "RLC_010_V2_D2"
        },
        {
          "id": "RLC_010_V2_D1",
          "type": "decision",
          "text": "What feels like the right next step for you?",
          "choices": [
            {
              "id": "RLC_010_V2_D1_C1",
              "text": "Ask another question",
              "next_node_id": "RLC_010_V2_D1_AFTER1"
            },
            {
              "id": "RLC_010_V2_D1_C2",
              "text": "Choose something else",
              "next_node_id": "RLC_010_V2_D1_AFTER2"
            },
            {
              "id": "RLC_010_V2_D1_C3",
              "text": "Use your backup",
              "next_node_id": "RLC_010_V2_D1_AFTER3"
            },
