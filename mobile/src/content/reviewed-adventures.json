              "text": "Ask what they know",
              "next_node_id": "RLC_010_V2_D2_AFTER1"
            },
            {
              "id": "RLC_010_V2_D2_C2",
              "text": "Say you’re still deciding",
              "next_node_id": "RLC_010_V2_D2_AFTER2"
            },
            {
              "id": "RLC_010_V2_D2_C3",
              "text": "Say you’re choosing something else",
              "next_node_id": "RLC_010_V2_D2_AFTER3"
            },
            {
