        },
        {
          "id": "RLC_010_V2_D3_AFTER2",
          "type": "consequence",
          "text": "You ask for support.",
          "next_node_id": "RLC_010_V2_END"
        },
        {
          "id": "RLC_010_V2_D3_AFTER3",
          "type": "consequence",
          "text": "You protect your privacy and attention.",
          "next_node_id": "RLC_010_V2_END"
        },
        {
          "id": "RLC_010_V2_D3",
          "type": "decision",
          "text": "The social plan continues. What matters now?",
